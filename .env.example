# Copia este archivo a .env.local y completa los valores.

# ── Base de datos ─────────────────────────────────────────────────────────────
# Producción: el connection string de Neon (el endpoint directo o el -pooler).
# Local: un Postgres propio, p. ej. postgres://postgres@localhost:5432/app
DATABASE_URL=
# Opcional: fuerza el driver ("pg" o "neon"). Sin definir, localhost → pg y
# cualquier otro host → Neon. Ver CONVENTIONS.md §"El driver de Neon".
# DATABASE_DRIVER=

# ── Auth (Better Auth) ────────────────────────────────────────────────────────
# Secreto de sesión: openssl rand -hex 32
BETTER_AUTH_SECRET=
# URL pública de la app. En local: http://localhost:3000
BETTER_AUTH_URL=https://allflow-sentinel-domain.example

# ── Correo ────────────────────────────────────────────────────────────────────
# Sin RESEND_API_KEY los correos se imprimen en la consola del servidor.
RESEND_API_KEY=
# Remitente con dominio verificado en Resend, p. ej. "Mi App <hola@midominio.cl>"
EMAIL_FROM=
# Opcional (dev/tests): además de imprimirlos, agrega cada correo a este archivo JSONL.
# DEV_MAIL_OUTBOX=.dev-outbox.jsonl
