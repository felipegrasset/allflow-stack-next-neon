# Copia este archivo a .env.local y completa los valores.

# ── Base de datos ─────────────────────────────────────────────────────────────
# Producción: el connection string de Neon (el endpoint directo o el -pooler).
# Local: un Postgres propio, p. ej. postgres://postgres@localhost:5432/app
DATABASE_URL=
# Opcional: fuerza el driver ("pg" o "neon"). Sin definir, localhost → pg y
# cualquier otro host → Neon. Ver CONVENTIONS.md §"El driver de Neon".
# DATABASE_DRIVER=

# ── Auth (Better Auth) ────────────────────────────────────────────────────────
# Secreto de sesión: openssl rand -hex 32
BETTER_AUTH_SECRET=
# URL pública de la app. En local: http://localhost:3000
BETTER_AUTH_URL=https://allflow-sentinel-domain.example

# ── Correo ────────────────────────────────────────────────────────────────────
# Sin RESEND_API_KEY los correos se imprimen en la consola del servidor.
RESEND_API_KEY=
# Remitente con dominio verificado en Resend, p. ej. "Mi App <hola@midominio.cl>"
EMAIL_FROM=
# Opcional (dev/tests): además de imprimirlos, agrega cada correo a este archivo JSONL.
# DEV_MAIL_OUTBOX=.dev-outbox.jsonl

# --- módulos (generado por modules:sync) ---
# No edites este bloque: `pnpm modules:sync` lo reescribe con las `env` de
# modules/*/manifest.json. Copia a .env.local las que uses y quítales el #.
#
# ── landing ──
# Base de la ingesta del CRM de Fulvia; el bloque de captura de lead hace POST
# a <base>/contacts. La fija la saga de la génesis.
# ALLFLOW_INGEST_URL=https://fulvia.app/api/ingest/v1
# Llave de ingesta de la app (Bearer afk_…). Sin ella el formulario responde
# con error en vez de fingir éxito.
# ALLFLOW_INGEST_KEY=
# Opcional. Con ella el formulario muestra Cloudflare Turnstile; sin ella
# queda el honeypot solo.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Opcional. Con ella el servidor exige y verifica el token de Turnstile.
# TURNSTILE_SECRET_KEY=
#
# ── payments ──
# sandbox (por defecto) o production. Sin production, no se toca plata real.
# PAYMENTS_ENV=sandbox
# Proveedor por defecto (mercadopago, flow o paddle). Vacío: el primero
# configurado entre Mercado Pago y Flow. Paddle solo si se nombra.
# PAYMENTS_PROVIDER=mercadopago
# URL pública de la app para las URLs de retorno y de notificación. Vacío:
# BETTER_AUTH_URL.
# PAYMENTS_BASE_URL=https://mi-app.example
# Access token de Mercado Pago (de Fulvia, o del cliente con BYOK). Secreto.
# MERCADOPAGO_ACCESS_TOKEN=<access token de prueba>
# Secreto de firma de los webhooks de Mercado Pago (x-signature). Sin él, el
# webhook rechaza. Secreto.
# MERCADOPAGO_WEBHOOK_SECRET=<secreto de firma>
# ApiKey de Flow (de Fulvia, o del cliente con BYOK).
# FLOW_API_KEY=<apikey>
# SecretKey de Flow: firma HMAC-SHA256 de cada llamada. Secreto.
# FLOW_SECRET_KEY=<secretkey>
# API key de Paddle del cliente. Solo apps que venden software o contenido
# digital propio. Secreto.
# PADDLE_API_KEY=<api key sandbox>
# Secreto de la notificación de Paddle. Sin él, el webhook rechaza. Secreto.
# PADDLE_WEBHOOK_SECRET=<secreto de notificación>
#
# ── storage ──
# Token de lectura y escritura del store de Vercel Blob (Vercel → Storage →
# Blob). Sin él, en producción las subidas responden 503; en desarrollo se usa
# un proveedor en memoria que se pierde al reiniciar. Secreto.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_<storeId>_<secreto>
# Acceso del store de Vercel Blob: private (por defecto) o public. Debe
# coincidir con cómo se creó el store. En un store public, los archivos
# privados siguen pasando por /api/storage/[id] y su URL nunca se entrega.
# STORAGE_BLOB_ACCESS=private
#
# ── whatsapp ──
# Quién envía: meta (Cloud API con credenciales propias), fulvia (a través de
# la plataforma; PENDIENTE, el endpoint aún no existe) o memory (solo
# desarrollo, rechazado en producción). Sin esta variable no sale ningún
# mensaje.
# WHATSAPP_PROVIDER=meta
# Token de acceso permanente de un usuario del sistema de Meta Business con
# permiso whatsapp_business_messaging. Secreto. Solo con
# WHATSAPP_PROVIDER=meta.
# WHATSAPP_META_TOKEN=EAAG<token-del-usuario-del-sistema>
# Id del número en WhatsApp Manager (no el número de teléfono). El webhook
# ignora eventos de otros números. Solo con meta.
# WHATSAPP_META_PHONE_NUMBER_ID=123456789012345
# Clave secreta de la app de Meta: firma el webhook (X-Hub-Signature-256). Sin
# ella el webhook rechaza todo (401). Secreto. Solo con meta.
# WHATSAPP_META_APP_SECRET=<clave-secreta-de-la-app>
# Texto que inventas y pegas en Meta al suscribir el webhook (handshake GET).
# Secreto. Solo con meta.
# WHATSAPP_META_VERIFY_TOKEN=<texto-aleatorio-largo>
# Versión de la Graph API. Opcional; por defecto v23.0.
# WHATSAPP_META_API_VERSION=v23.0
# ALLFLOW_INGEST_URL: la misma de landing, más arriba.
# ALLFLOW_INGEST_KEY: la misma de landing, más arriba.
# Secreto con que Fulvia firmaría (HMAC-SHA256, X-Hub-Signature-256) los
# eventos que reenvía al webhook. PENDIENTE en la plataforma. Secreto. Solo
# con fulvia.
# WHATSAPP_FULVIA_WEBHOOK_SECRET=<secreto-compartido>
# --- fin módulos (generado por modules:sync) ---
