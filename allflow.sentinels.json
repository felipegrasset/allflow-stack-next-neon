{
  "version": 1,
  "sentinels": [
    {
      "literal": "allflow-sentinel-app-name",
      "value": "{{appName}}",
      "files": ["package.json", "lib/site.ts"]
    },
    {
      "literal": "Allflow Sentinel App",
      "value": "{{appTitle}}",
      "files": ["lib/site.ts"]
    },
    {
      "literal": "https://allflow-sentinel-domain.example",
      "value": "https://{{domain}}",
      "files": [".env.example", "lib/site.ts"]
    },
    {
      "literal": "--brand-h: 195;",
      "value": "--brand-h: {{brandH}};",
      "files": ["app/globals.css"]
    },
    {
      "literal": "--brand-c: 0.12;",
      "value": "--brand-c: {{brandC}};",
      "files": ["app/globals.css"]
    },
    {
      "literal": "--radius: 0.625rem;",
      "value": "--radius: {{radius}};",
      "files": ["app/globals.css"]
    },
    {
      "literal": "--density: 1;",
      "value": "--density: {{density}};",
      "files": ["app/globals.css"]
    },
    {
      "literal": "Geist as HeadingFont",
      "value": "{{fontHeading}} as HeadingFont",
      "files": ["app/fonts.ts"]
    },
    {
      "literal": "Geist as BodyFont",
      "value": "{{fontBody}} as BodyFont",
      "files": ["app/fonts.ts"]
    },
    {
      "literal": "data-default-theme=\"system\"",
      "value": "data-default-theme=\"{{colorMode}}\"",
      "files": ["app/layout.tsx"]
    }
  ]
}
