{
  "schema": 1,
  "id": "catalog",
  "feature": "catalog",
  "version": "0.1.0",
  "title": "Catálogo",
  "description": "Productos con atributos libres, categorías, fotos (vía storage) y stock calculado como suma de movimientos. Precio en unidad menor + moneda. Tienda pública en /productos y un contrato para el checkout: leer productos vendibles, reservar y liberar stock de forma atómica e idempotente.",
  "dependsOn": ["storage"],
  "tables": ["catalog_categories", "catalog_items", "catalog_stock_moves"],
  "migrations": ["0106_catalog_init"],
  "routes": [
    { "path": "/catalog", "entry": "ui/admin-page.tsx" },
    { "path": "/catalog/[id]", "entry": "ui/item-page.tsx" },
    { "path": "/productos", "entry": "ui/public-list-page.tsx", "group": "marketing" },
    { "path": "/productos/[slug]", "entry": "ui/public-item-page.tsx", "group": "marketing" }
  ],
  "covers": [
    "producto",
    "product",
    "artículo",
    "item",
    "categoría",
    "category",
    "inventario",
    "inventory",
    "stock",
    "existencia",
    "movimiento de stock",
    "stock movement"
  ],
  "entrypoints": {
    "nav": "nav.ts",
    "permissions": "permissions.ts",
    "seed": "seed.ts",
    "messages": "messages.ts"
  }
}
